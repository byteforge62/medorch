  "cards": [
    {
      "dot": "cyan",
      "title": "Application shape",
      "items": [
        "One Next.js App Router application; pages and API handlers share the TypeScript runtime.",
        "Domain code is grouped under src/modules/<domain> with service, repository, and validation files.",
        "Start with PROJECT_CONTEXT.md for the route matrix, schema relations, conventions, and data flows."
      ]
    },
    {
      "dot": "emerald",
      "title": "Scheduling controls",
      "items": [
        "Schedule create/update checks active department, compatible room, active doctor, time range, and room/surgeon overlap.",
        "Status transitions and resource assignment checks live in schedule.service.ts, not only in request schemas."
      ]
    },
    {
      "dot": "rose",
      "title": "Identity and persistence",
      "items": [
        "Credentials reject non-ACTIVE accounts; JWT sessions carry user ID, role, and status.",
        "Route handlers use explicit role allowlists; alerts and schedule notes add service-level ownership checks.",
        "Mutating domain services await AuditLog writes through a separate audit service/repository."
      ]
    }
  ]
