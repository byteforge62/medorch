generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  DOCTOR
  OT_STAFF
  PATIENT
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum OTRoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  DISABLED
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
}

enum ScheduleStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DELAYED
}

enum SchedulePriority {
  ELECTIVE
  URGENT
  EMERGENCY
}

enum StaffRole {
  SURGEON
  NURSE
  ANESTHETIST
  TECHNICIAN
  OTHER
}

enum AlertType {
  SCHEDULE
  RESOURCE
  SYSTEM
  MAINTENANCE
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  CANCEL
  COMPLETE
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  phone        String?
  role         UserRole   @default(PATIENT)
  status       UserStatus @default(PENDING)
  approvedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  doctorProfile DoctorProfile?
  patient       Patient?

  createdSchedules Schedule[]      @relation("ScheduleCreatedBy")
  surgeonSchedules Schedule[]      @relation("ScheduleSurgeon")
  scheduleStaff    ScheduleStaff[]
  scheduleNotes    ScheduleNote[]
  alerts           Alert[]
  auditLogs        AuditLog[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model DoctorProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  departmentId   String?
  specialization String?
  licenseNumber  String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department       Department? @relation("DepartmentDoctors", fields: [departmentId], references: [id], onDelete: SetNull)
  headedDepartment Department? @relation("DepartmentHead")

  @@index([departmentId])
}

model Patient {
  id             String    @id @default(uuid())
  patientCode    String    @unique
  userId         String?   @unique
  name           String
  email          String?
  phone          String?
  dateOfBirth    DateTime?
  gender         String?
  medicalHistory String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  schedules Schedule[]

  @@index([name])
  @@index([phone])
}

model Department {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String?
  headDoctorId String?  @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  headDoctor DoctorProfile?  @relation("DepartmentHead", fields: [headDoctorId], references: [id], onDelete: SetNull)
  doctors    DoctorProfile[] @relation("DepartmentDoctors")
  otRooms    OTRoom[]
  equipment  Equipment[]
  schedules  Schedule[]

  @@index([isActive])
}

model OTRoom {
  id           String       @id @default(uuid())
  name         String
  code         String       @unique
  departmentId String
  capacity     Int?
  status       OTRoomStatus @default(AVAILABLE)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  schedules  Schedule[]

  @@index([departmentId])
  @@index([status])
  @@index([isActive])
}

model Equipment {
  id               String          @id @default(uuid())
  name             String
  category         String
  serialNumber     String?         @unique
  status           EquipmentStatus @default(AVAILABLE)
  departmentId     String?
  maintenanceDueAt DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  department        Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  scheduleEquipment ScheduleEquipment[]

  @@index([category])
  @@index([status])
  @@index([departmentId])
  @@index([maintenanceDueAt])
}

model Schedule {
  id            String           @id @default(uuid())
  patientId     String
  departmentId  String
  otRoomId      String
  surgeonId     String
  createdById   String
  procedure     String
  scheduledDate DateTime
  startTime     DateTime
  endTime       DateTime
  status        ScheduleStatus   @default(SCHEDULED)
  priority      SchedulePriority @default(ELECTIVE)
  clinicalNotes String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  patient    Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  otRoom     OTRoom     @relation(fields: [otRoomId], references: [id], onDelete: Restrict)
  surgeon    User       @relation("ScheduleSurgeon", fields: [surgeonId], references: [id], onDelete: Restrict)
  createdBy  User       @relation("ScheduleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  staff     ScheduleStaff[]
  equipment ScheduleEquipment[]
  notes     ScheduleNote[]
  alerts    Alert[]

  @@index([patientId])
  @@index([departmentId])
  @@index([otRoomId])
  @@index([surgeonId])
  @@index([createdById])
  @@index([scheduledDate])
  @@index([startTime, endTime])
  @@index([status])
  @@index([priority])
}

model ScheduleStaff {
  id         String    @id @default(uuid())
  scheduleId String
  userId     String
  role       StaffRole
  assignedAt DateTime  @default(now())

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([scheduleId, userId, role])
  @@index([scheduleId])
  @@index([userId])
}

model ScheduleEquipment {
  id          String    @id @default(uuid())
  scheduleId  String
  equipmentId String
  assignedAt  DateTime  @default(now())
  releasedAt  DateTime?

  schedule  Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@unique([scheduleId, equipmentId])
  @@index([scheduleId])
  @@index([equipmentId])
}

model ScheduleNote {
  id         String   @id @default(uuid())
  scheduleId String
  authorId   String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([scheduleId])
  @@index([authorId])
}

model Alert {
  id         String        @id @default(uuid())
  userId     String
  scheduleId String?
  type       AlertType
  title      String
  message    String
  severity   AlertSeverity @default(INFO)
  isRead     Boolean       @default(false)
  readAt     DateTime?
  createdAt  DateTime      @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule Schedule? @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([scheduleId])
  @@index([severity])
  @@index([createdAt])
}

model AuditLog {
  id          String      @id @default(uuid())
  userId      String?
  action      AuditAction
  entity      String
  entityId    String
  description String?
  metadata    Json?
  createdAt   DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
}
