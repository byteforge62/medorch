# PostgreSQL used by Prisma and the application (local development default).
DATABASE_URL="postgresql://medorch:medorch_dev_password@localhost:5432/medorch"

RESEND_API_KEY="your_actual_resend_api_key"
EMAIL_FROM="MedOrch <onboarding@resend.dev>"
NEXTAUTH_URL="http://localhost:3000"
# Google OAuth (NextAuth). Add these to .env.local and restart.
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_SECRET=""

# Isolated database for automated tests (name must end in _test, loopback host).
TEST_DATABASE_URL=postgresql://medorch:medorch_dev_password@localhost:5432/medorch_test
